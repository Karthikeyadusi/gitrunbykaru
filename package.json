{
  "name": "gitrunbykaru",
  "version": "2.1.1",
  "description": "Run conventional GitHub repositories locally with one command.",
  "homepage": "https://gitrunbykaru.vercel.app",
  "type": "module",
  "bin": {
    "gitrunbykaru": "bin/gitrunbykaru.js",
    "grbk": "bin/gitrunbykaru.js"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node bin/gitrunbykaru.js",
    "test": "node tests/test.js",
    "dev": "npm run dev --prefix website",
    "web:dev": "npm run dev --prefix website",
    "web:build": "npm run build --prefix website",
    "mcp": "node src/mcp/server.js"
  },
  "keywords": [
    "cli",
    "nodejs",
    "github",
    "developer-tools",
    "automation",
    "npm",
    "productivity",
    "open-source",
    "command-line",
    "mcp"
  ],
  "author": "Karthikeya Dusi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karthikeyadusi/gitrunbykaru.git"
  },
  "bugs": {
    "url": "https://github.com/Karthikeyadusi/gitrunbykaru/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "open": "^10.0.3",
    "ora": "^8.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
